{
  "name": "fire-inspect",
  "version": "1.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "seed:nfpa-templates:dry": "tsx scripts/seedNFPATemplates.ts --company 1 --dry-run",
    "seed:nfpa-templates": "tsx scripts/seedNFPATemplates.ts --company 1",
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "cap:build": "vite build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android",
    "cap:sync": "npx cap sync android",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "backfill:building-ids:dry": "tsx scripts/backfillSiteBuildingIds.ts --file \"./client/src/data/FILE MONTHLY SERVICE LIST (1).xlsx\" --company 1 --dry-run",
    "backfill:building-ids": "tsx scripts/backfillSiteBuildingIds.ts --file \"./client/src/data/FILE MONTHLY SERVICE LIST (1).xlsx\" --company 1",
    "backfill:building-ids:headers": "tsx scripts/backfillSiteBuildingIds.ts --file \"./client/src/data/FILE MONTHLY SERVICE LIST (1).xlsx\" --dump-headers",
    "sites:create-missing:dry": "tsx scripts/createMissingSitesFromWorkbook.ts --file \"./client/src/data/FILE MONTHLY SERVICE LIST (1).xlsx\" --company 1 --dry-run",
    "sites:create-missing": "tsx scripts/createMissingSitesFromWorkbook.ts --file \"./client/src/data/FILE MONTHLY SERVICE LIST (1).xlsx\" --company 1",
    "seed:monthly-tracking:all": "tsx scripts/seedMonthlyTracking.ts --file \"./client/src/data/FILE MONTHLY SERVICE LIST (1).xlsx\" --company 1 --all-sheets",
    "seed:monthly-tracking:dry": "tsx scripts/seedMonthlyTracking.ts --file \"./client/src/data/FILE MONTHLY SERVICE LIST (1).xlsx\" --company 1 --all-sheets --dry-run",
    "import:summary-sheets:dry": "tsx scripts/importSitesFromSummarySheets.ts --company 1 --dry-run --create-missing-orgs --json-report ./tmp/import-report.json",
    "import:summary-sheets": "tsx scripts/importSitesFromSummarySheets.ts --company 1 --create-missing-orgs --update-existing-sites",
    "seed:parts-catalog:dry": "tsx scripts/seedPartsCatalogFromWorkbook.ts --file \"./data/imports/parts_workbook.xlsm\" --company 1 --dry-run",
    "seed:parts-catalog": "tsx scripts/seedPartsCatalogFromWorkbook.ts --file \"./data/imports/parts_workbook.xlsm\" --company 1",
    "seed:sites-from-customer-records:dry": "tsx scripts/seedSitesFromCustomerRecords.ts --company 1 --dry-run",
    "seed:sites-from-customer-records": "tsx scripts/seedSitesFromCustomerRecords.ts --company 1",
    "normalize:site-names:dry": "tsx scripts/normalizeSiteNames.ts",
    "normalize:site-names": "tsx scripts/normalizeSiteNames.ts --apply",
    "backfill:work-site-info:dry": "tsx scripts/backfillWorkSiteInfoFromCustomerRecords.ts",
    "backfill:work-site-info": "tsx scripts/backfillWorkSiteInfoFromCustomerRecords.ts --apply",
    "backfill:contacts:dry": "tsx scripts/backfillContactsFromCustomerRecords.ts",
    "backfill:contacts": "tsx scripts/backfillContactsFromCustomerRecords.ts --apply",
    "audit:site-dependencies": "tsx scripts/auditSiteDependencies.ts",
    "site:audit-dependencies": "tsx scripts/auditSiteDependencies.ts",
    "site:audit-reconciliation": "tsx scripts/auditSiteCustomerRecordReconciliation.ts",
    "master-data:validate": "tsx scripts/validateMasterData.ts",
    "master-data:validate:strict": "tsx scripts/validateMasterData.ts --strict"
  },
