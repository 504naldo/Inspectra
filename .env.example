# ─────────────────────────────────────────────────────────────────────────────
# Inspectra — environment variables
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every value below is a placeholder; no real secret belongs in this file.
# Variables are read in server/_core/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public base URL of the app (no trailing slash), used for OAuth redirects & email links
APP_URL=http://localhost:5173

# ── Database (MySQL / PlanetScale) ────────────────────────────────────────────
# The app starts without this, but all data features are disabled until it is set.
DATABASE_URL=mysql://user:password@host:3306/inspectra

# ── Auth / session ────────────────────────────────────────────────────────────
# Secret used to sign the session JWT. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Google OAuth credentials (Google Cloud Console → Credentials → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails auto-assigned the admin role on first login
ADMIN_EMAILS=
# Email domain whose users are auto-activated as technicians on first login (e.g. example.ca)
COMPANY_DOMAIN=

# ── File storage (S3 / Cloudflare R2) ─────────────────────────────────────────
# Renamed away from the AWS_ prefix so Railway does not intercept them.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set only for Cloudflare R2 (leave empty for AWS S3)
S3_ENDPOINT=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# From/notification address for outbound mail
NOTIFICATION_EMAIL=

# ── AI (OpenAI) ───────────────────────────────────────────────────────────────
# Optional. When absent, AI assistants degrade gracefully (no AI features).
OPENAI_API_KEY=

# ── Google Maps (route-aware scheduling / geocoding) ──────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Customer Records — Google Drive ───────────────────────────────────────────
# Drive folder ID that roots all customer records (required to enable the feature)
GOOGLE_DRIVE_CUSTOMER_ROOT_ID=
# Set if the root lives in a Shared Drive (Team Drive); leave empty for My Drive
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_USE_SHARED_DRIVE=false

# ── Customer Records — legacy SMB share (superseded by Google Drive) ──────────
CUSTOMER_SHARE_ROOT=
CUSTOMER_SHARE_USERNAME=
CUSTOMER_SHARE_PASSWORD=
CUSTOMER_SHARE_DOMAIN=

# ── Push notifications (Firebase Cloud Messaging) ─────────────────────────────
FIREBASE_PROJECT_ID=
# Paste the service-account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Analytics (optional, referenced by index.html) ────────────────────────────
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ── App entry / marketing site ────────────────────────────────────────────────
# The public marketing website lives in its own repo (504naldo/inspectra-website).
# Optional link shown on the app entry screen; defaults to https://inspectrafire.ca.
VITE_INSPECTRA_WEBSITE_URL=https://inspectrafire.ca

# ── Frontend (Vite) public keys ───────────────────────────────────────────────
# Exposed to the browser at build time (VITE_ prefix) — these are PUBLIC, not
# secrets. They mirror their server-side counterparts above and are required for
# the client Google OAuth button (client/src/const.ts) and the embedded map
# (client/src/components/Map.tsx).
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
